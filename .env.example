# Local defaults. Replace every value before this is used anywhere but your own machine.
# Never commit .env. Never put real customer data or real keys here.

PORT=4000
MONGODB_URI=mongodb://localhost:27017/finops
JWT_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://localhost:5173

STORAGE_ENDPOINT=https://storage.example.com
STORAGE_BUCKET=finops-files
STORAGE_ACCESS_KEY=replace-me
STORAGE_SECRET_KEY=replace-me

AI_PROVIDER=gemini
AI_API_KEY=replace-me
AI_MODEL=gemini-3.5-flash
AI_TIMEOUT_MS=90000
# Optional. Leave blank to store token counts without inventing a price.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=

MAX_UPLOAD_BYTES=8388608
UPLOAD_DIR=uploads

# Leave blank to have the seed script print a password once.
SEED_STAFF_PASSWORD=
SEED_ACCOUNTANT_PASSWORD=
SEED_ADMIN_PASSWORD=

# Zoho Books: expenses, follow-up invoice read, and Payments customer payments.
# ZOHO_DC must match the site you sign in to: com, in, eu, au, jp, ca, sa, or ae.
# Account ids are saved on the overview for expenses. For Payments, set the deposit bank account:
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_DC=
ZOHO_ORGANIZATION_ID=
ZOHO_REDIRECT_URI=http://localhost:4000/auth/zoho/callback
ZOHO_REFRESH_TOKEN=
ZOHO_PAYMENT_DEPOSIT_ACCOUNT_ID=5802591000000144205
# Exact Zoho payment mode label for Payments Received (default matches this org).
ZOHO_PAYMENT_MODE=Bank Transfer
# Unpaid invoices are copied into MongoDB: full read at 02:00 Bali time, changes every 2 minutes.
# Set to off to stop the background reads (for example on a second local copy of the app).
ZOHO_INVOICE_SYNC=on

# Deliveries + Cartrack Fleet API (Indonesia).
CARTRACK_BASE_URL=https://fleetapi-id.cartrack.com/rest
CARTRACK_USERNAME=
CARTRACK_API_KEY=
# Depot used for route ordering and WhatsApp map directions (Bali default).
DEPOT_LAT=-8.6705
DEPOT_LNG=115.2126

SEED_DELIVERY_PASSWORD=
